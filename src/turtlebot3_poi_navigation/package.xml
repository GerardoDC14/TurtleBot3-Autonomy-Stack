<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot3_poi_navigation</name>
  <version>0.1.0</version>
  <description>Interactive ROS 2 point-of-interest manager for storing named goals and dispatching Nav2 missions.</description>
  <maintainer email="123440177+GerardoDC14@users.noreply.github.com">Gerardo Escobar</maintainer>
  <license>All rights reserved</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_srvs</depend>
  <depend>autonomy_common</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
