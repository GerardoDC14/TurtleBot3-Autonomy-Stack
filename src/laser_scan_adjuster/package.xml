<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>laser_scan_adjuster</name>
  <version>0.1.0</version>
  <description>ROS 2 LaserScan adapter that normalizes range-array length and republishes sensor-data QoS.</description>
  <maintainer email="123440177+GerardoDC14@users.noreply.github.com">Gerardo Escobar</maintainer>
  <license>All rights reserved</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
